{
  "name": "hyde-mcp-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Agents read production logs and database without seeing personal data.",
  "type": "module",
  "engines": { "node": ">=24.2" },
  "scripts": {
    "dev": "node src/mcp/main.ts",
    "start": "node src/mcp/main.ts",
    "schemas": "node scripts/fetch-log-schemas.ts",
    "fetch:redacted-schemas": "node scripts/fetch-redacted-schemas.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "infra:diff": "node scripts/infra/apply.ts diff production --strict",
    "infra:apply": "node --env-file=apply.env scripts/infra/apply.ts apply production"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hyde-json": "workspace:*",
    "mysql2": "^3.24.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.9.1"
}
